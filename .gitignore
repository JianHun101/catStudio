# 依赖
node_modules/

# 环境变量（包含 API Key，绝对不能提交）
.env

# Claude Code 本地设置（本机许可配置，曾 auto-commit 卷回 bcbf5c5 已 rebase 摘除——本地文件不入库）
.claude/settings.local.json

# skill 单源挂载位（skills/ 是唯一真相源；挂载位由 scripts/skills-bootstrap.mjs 重建，不入库）
.claude/skills
# skill 同步溯源文件（机器生成：source_commit/secret_scan 结果，不入库）
skills/.sync-provenance.json

# 构建产物
dist/
.vite/

# 测试覆盖率报告（生成物；曾误跟踪——2026-09-01 起 untrack + 忽略，防 server auto-commit 卷回）
coverage/

# 数据库（本地数据不提交）
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Agent 工作区（Agent 文件操作隔离目录）
workspace/

# 日志
*.log
*.log.*

# Agent 执行锁（防止 tsx watch 在 Agent 执行期间重启）
.agent-busy

# 重启确认机制（店长发【重启请求】→ 前端确认 → dev.js 重启；工作流状态文件不入库）
.restart-request
.restart-done
# 关停握手（票巳 (b)：dev.js 按钮重启前写、server 自检消费；工作流状态文件不入库）
.shutdown-request

# NapCat 生命周期（.napcat-pid 记录 dev.js 拉起的实例所有权；.napcat-request 是 server 薄桥→dev.js 的启停请求文件；.napcat-config.json 是配置页面保存的启动路径——本机环境数据，换机器不同；工作流状态文件不入库）
.napcat-pid
.napcat-request
.napcat-config.json

# 审查门禁（本地工作流状态，不提交）
.push-gate
.handoff-draft.md
.handoff-draft.sent
.handoff-delivered.json

# e2e 测试标记（存在时 server 跳过 auto-commit，绝不能提交）
scripts/.e2e-testing
# e2e 触发文件（post-commit 触发道具——防 server auto-commit 的 git add -A 误扫；脚本用 git add -f 强制提交）
scripts/.e2e-test-trigger.txt

# UI 截图脚本产物（生成物，不入库）
scripts/shots/
# 截图脚本路径拼接 bug 产物（cwd 已在 scripts/ 下又拼 scripts/shots/ → 实际落在 scripts/scripts/shots/）
scripts/scripts/
# ui-screenshot 产物（落在 packages/server/data/ui-shots/，曾误提交 b43842e 已回滚；旧 shot-1785491233400.png 仍跟踪待批 untrack）
packages/server/data/ui-shots/
# 会话调试快照（tmp_msgs*/tmp_sessions，untrack 后防 server auto-commit 的 git add -A 卷回——3cb2823 后 5 个 json 无规则被卷回 8331cd6，已回滚补规则根治）
packages/server/data/tmp_*.json
# Phase 0 评估产物（phase0 --collect 写 phase0-samples.json/phase0-report.json，防 server auto-commit 的 git add -A 误扫——8d33bfa 审查非阻塞项）
packages/server/data/eval/
