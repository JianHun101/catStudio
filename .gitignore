# 依赖
node_modules/

# 环境变量（包含 API Key，绝对不能提交）
.env

# 构建产物
dist/
.vite/

# 数据库（本地数据不提交）
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Agent 工作区（Agent 文件操作隔离目录）
workspace/

# 日志
*.log

# Agent 执行锁（防止 tsx watch 在 Agent 执行期间重启）
.agent-busy

# 审查门禁（本地工作流状态，不提交）
.push-gate
.handoff-draft.md
.handoff-draft.sent

# e2e 测试标记（存在时 server 跳过 auto-commit，绝不能提交）
scripts/.e2e-testing
