#!/usr/bin/env sh
# pre-push 审查门禁：检查 HEAD 是否已经过 @吐槽猫 review
# 审查通过后运行: git rev-parse HEAD > .push-gate
# 紧急绕过: git push --no-verify
#
# 自动投递：如果 .handoff-draft.md 存在，自动 POST 到 cat-study 触发 @吐槽猫 审查

GATE_FILE=".push-gate"
HANDOFF_FILE=".handoff-draft.md"
CATSTUDY_URL="${CATSTUDY_API_URL:-http://127.0.0.1:3200}"

# 投递目标会话（店长工作会话）。必须显式指定——API 按 updated_at 排序，
# 不指定会投到"最新活跃会话"（曾打到 UI优化）。会话重建后更新此值。
export CATSTUDY_SESSION_ID=46fbcdc0-5ab4-4d92-8808-68322bdfb91c

# ─── 辅助：获取或创建 session ──────────────────────────

get_session_id() {
  # 优先级：环境变量 → API 查询 → 回退
  if [ -n "$CATSTUDY_SESSION_ID" ]; then
    echo "$CATSTUDY_SESSION_ID"
    return 0
  fi

  # 尝试从 API 获取第一个 session
  SESSION_ID=$(curl -s "${CATSTUDY_URL}/api/sessions" 2>/dev/null | \
    grep -o '"id":"[^"]*"' 2>/dev/null | head -1 | cut -d'"' -f4)

  if [ -n "$SESSION_ID" ]; then
    echo "$SESSION_ID"
    return 0
  fi

  return 1
}

# ─── 辅助：投递交接文档到 cat-study ─────────────────────

submit_handoff() {
  SESSION_ID=$(get_session_id)
  if [ -z "$SESSION_ID" ]; then
    echo ""
    echo "⚠️  无法获取 cat-study session ID（API 不可达或 CATSTUDY_SESSION_ID 未设）"
    echo "   跳过自动投递。请手动在 cat-study 会话中发送交接文档。"
    echo ""
    return 1
  fi

  CONTENT=$(cat "$HANDOFF_FILE")
  if [ -z "$CONTENT" ]; then
    echo ""
    echo "⚠️  .handoff-draft.md 为空，跳过自动投递"
    echo ""
    return 1
  fi

  echo ""
  echo "📤 正在投递交接文档到 cat-study..."

  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "${CATSTUDY_URL}/api/messages" \
    -H "Content-Type: application/json" \
    -d "{\"sessionId\":\"${SESSION_ID}\",\"content\":$(echo "$CONTENT" | python3 -c "import sys,json;print(json.dumps(sys.stdin.read()))" 2>/dev/null || echo "$CONTENT" | node -e "const c=require('fs').readFileSync(0,'utf8');console.log(JSON.stringify(c))" 2>/dev/null || echo '""'),\"mentions\":[\"吐槽猫\"]}" \
    2>/dev/null)

  if [ "$HTTP_CODE" = "201" ]; then
    echo "✅ 审查请求已投递。在 cat-study 会话页面查看吐槽猫的回复。"
    echo ""
    # 清理草稿（投递成功）
    rm -f "$HANDOFF_FILE"
  else
    echo "⚠️  投递失败（HTTP ${HTTP_CODE:-连接失败}）。请确认 cat-study server 在 ${CATSTUDY_URL} 运行。"
    echo "   手动投递：在 cat-study 会话中粘贴 .handoff-draft.md 的内容"
    echo ""
  fi
}

# ─── 门禁检查 ──────────────────────────────────────────

if [ ! -f "$GATE_FILE" ]; then
  echo ""
  echo "❌ 推送阻断：未找到审查记录 (.push-gate)"
  echo ""
  echo "   当前 HEAD 未经 @吐槽猫 review。请先完成审查流程："
  echo "   1. 出交接文档，@吐槽猫 review"
  echo "   2. 审查通过后运行: git rev-parse HEAD > .push-gate"
  echo "   3. 再次 git push"
  echo ""
  echo "   紧急绕过: git push --no-verify"
  echo ""

  # 自动投递交接文档（如果存在）
  if [ -f "$HANDOFF_FILE" ]; then
    submit_handoff
  else
    echo "💡 提示：如果 post-commit hook 已自动投递到 cat-study，审查可能正在进行中。"
    echo "   在 cat-study 会话页面查看实时进度。"
    echo ""
  fi

  exit 1
fi

LAST_REVIEWED=$(cat "$GATE_FILE" | tr -d '[:space:]')
HEAD_SHA=$(git rev-parse HEAD)

# 防止空文件或无效内容绕过门禁
if ! echo "$LAST_REVIEWED" | grep -qE '^[0-9a-f]{40}$'; then
  echo ""
  echo "❌ .push-gate 内容无效（需要完整的 40 位 SHA）"
  echo ""
  echo "   当前内容: '${LAST_REVIEWED}'"
  echo "   审查通过后运行: git rev-parse HEAD > .push-gate"
  echo ""
  exit 1
fi

if [ "$LAST_REVIEWED" = "$HEAD_SHA" ]; then
  exit 0
fi

# HEAD 有新未审查 commit（LAST_REVIEWED 是 HEAD 的祖先）
if git merge-base --is-ancestor "$LAST_REVIEWED" "$HEAD_SHA" 2>/dev/null; then
  echo ""
  echo "❌ 推送阻断：HEAD 有新 commit 未经 @吐槽猫 review"
  echo ""
  echo "   最后审查: $(git rev-parse --short "$LAST_REVIEWED")"
  echo "   当前 HEAD: $(git rev-parse --short "$HEAD_SHA")"
  echo ""
  echo "   审查通过后运行: git rev-parse HEAD > .push-gate"
  echo "   紧急绕过: git push --no-verify"
  echo ""

  # 自动投递交接文档（如果存在）
  if [ -f "$HANDOFF_FILE" ]; then
    # 重新生成覆盖全部未审查 commit 的交接文档（合并多 commit 一轮审）
    # 失败时保留旧草稿（handoff-gen 失败不删文件），继续投递
    if command -v node >/dev/null 2>&1; then
      # 成功与否以草稿是否真的包含目标范围为准——handoff-gen 失败也 exit 0，
      # 只靠退出码判断会输出假成功提示（曾因 parseArgs 只认空格形式静默丢失 = 形式）
      if node scripts/handoff-gen.mjs --no-post --range="$LAST_REVIEWED..$HEAD_SHA" >/dev/null 2>&1 \
        && grep -qF "$LAST_REVIEWED..$HEAD_SHA" "$HANDOFF_FILE" 2>/dev/null; then
        echo "   ✅ 交接文档已按未审查范围 ($(git rev-parse --short "$LAST_REVIEWED")..$(git rev-parse --short "$HEAD_SHA")) 重新生成"
      else
        echo "   ⚠️ 交接文档按未审查范围重新生成失败，沿用旧草稿投递（可能只覆盖最后一个 commit）"
      fi
    fi
    submit_handoff
  else
    echo "💡 提示：如果 post-commit hook 已自动投递到 cat-study，审查可能正在进行中。"
    echo "   在 cat-study 会话页面查看实时进度。"
    echo ""
  fi

  exit 1
fi

# LAST_REVIEWED 不是 HEAD 的祖先（reset/rebase 后）
echo ""
echo "⚠️  审查记录与当前历史不一致（可能发生了 reset/rebase）。"
echo "   如当前 HEAD 已经过审查，运行: git rev-parse HEAD > .push-gate"
echo ""
exit 0
