#!/usr/bin/env sh
# pre-push 审查门禁：检查**本次推送的每个 sha** 是否已经过 @吐槽猫 review
# 审查通过后运行: git rev-parse HEAD > .push-gate
# 紧急绕过: git push --no-verify
#
# T-O：被审对象 = **本次推送的 refspec**，不是 HEAD。
#   旧实现只读 `git rev-parse HEAD`，于是 `git push origin <未审 sha>:refs/heads/x`
#   在「HEAD 恰好停在已审点」时落进「LAST_REVIEWED == HEAD_SHA → exit 0」分支
#   **整条放行**。审计对象必须与执行对象同面——git 在 stdin 逐行传的就是本次要推的
#   `<local ref> <local sha> <remote ref> <remote sha>`，不读 stdin 等于换了判据面。
#   回落 HEAD 只在「一行 refspec 都没解析出」（人工直跑 / 无 stdin）时生效——
#   删除 ref（local sha 全 0）是一行合法的 refspec，无对象可审 ⇒ 放行，不回落。
#
# 自动补投：调用 handoff-gen.mjs --gate-deliver 补投滞留的交接文档
# （pending 队列按 SHA 补投 + 兜底投递 HEAD）。
# 投递逻辑全部在 JS 单源——shell 不再重复实现投递（曾有两套投递实现：
# shell 投裸草稿 + mentions:["吐槽猫"]，与 JS 的补填包裹形状不一致，且
# pre-push 会重新生成范围版文档造成双版本重复投递，已随重复投递根治计划
# Fix C 移除）。

GATE_FILE=".push-gate"
ZERO_SHA="0000000000000000000000000000000000000000"

# ─── 辅助：补投滞留交接文档（委托 handoff-gen.mjs 单源） ───────

deliver_pending() {
  if command -v node >/dev/null 2>&1; then
    echo ""
    echo "📤 补投滞留的交接文档（--gate-deliver：pending 队列 + 兜底 HEAD）..."
    node scripts/handoff-gen.mjs --gate-deliver
    echo ""
  else
    echo "⚠️  node 不可用，跳过自动补投（草稿滞留 .handoff-draft.md，可人工处理）"
    echo ""
  fi
}

# ─── 门禁前置：.push-gate 必须存在且内容合法 ──────────────────

if [ ! -f "$GATE_FILE" ]; then
  echo ""
  echo "❌ 推送阻断：未找到审查记录 (.push-gate)"
  echo ""
  echo "   当前 HEAD 未经 @吐槽猫 review。请先完成审查流程："
  echo "   1. 出交接文档，@吐槽猫 review"
  echo "   2. 审查通过后运行: git rev-parse HEAD > .push-gate"
  echo "   3. 再次 git push"
  echo ""
  echo "   紧急绕过: git push --no-verify"
  echo ""

  # 自动补投滞留交接文档（pending 队列 / 未投递的 HEAD）
  deliver_pending

  exit 1
fi

LAST_REVIEWED=$(cat "$GATE_FILE" | tr -d '[:space:]')

# 防止空文件或无效内容绕过门禁
if ! echo "$LAST_REVIEWED" | grep -qE '^[0-9a-f]{40}$'; then
  echo ""
  echo "❌ .push-gate 内容无效（需要完整的 40 位 SHA）"
  echo ""
  echo "   当前内容: '${LAST_REVIEWED}'"
  echo "   审查通过后运行: git rev-parse HEAD > .push-gate"
  echo ""
  exit 1
fi

# ─── 逐个校验本次推送的 sha ──────────────────────────────────
#
# git 为每个待推 ref 传一行（无需推送的 ref 不传；ref 删除传 40 个 0）。
# 用 here-doc 喂 while read——POSIX sh 里 here-doc **不开**子 shell，
# 循环里置的 blocked / checked 能带回父 shell（用管道会丢在子 shell 里）。

PUSH_SPECS=$(cat)
blocked=0
saw_refspec=0
blocked_list=""
ok_list=""

while read -r local_ref local_sha remote_ref remote_sha; do
  # 空行 / 字段不全的行跳过（git 不会传这种行；人工直跑 hook 时压根没有 stdin）
  [ -z "$local_sha" ] && continue

  # 解析到了一行 refspec —— 这与「其中几行可审」是**两件事**，计数必须在这里自增。
  # 若落到下面「删除 ref」那个 continue 之后才自增，「只删远端 ref」就会漏计，
  # 被下方的「一行都没解析出」回落分支捞走、转去校验 HEAD：删除动作于是被 HEAD
  # 的审查状态左右，回报还误导成「有未审 commit」（T-O 复审 必改 2 实测复现）。
  saw_refspec=$((saw_refspec + 1))

  # 非 hex → 拒（fail-closed：看不懂的输入不放行）
  case "$local_sha" in
    *[!0-9a-f]*)
      blocked=1
      blocked_list="${blocked_list}   - ${remote_ref:-?}（非法 sha: ${local_sha}）\n"
      continue
      ;;
  esac
  if [ "${#local_sha}" -ne 40 ]; then
    blocked=1
    blocked_list="${blocked_list}   - ${remote_ref:-?}（sha 长度非 40: ${local_sha}）\n"
    continue
  fi

  # 删除 ref（local sha 全 0）：无对象可审，放行。
  # 它**已经**被上面的 saw_refspec 计过——放行的是这一行 refspec 本身，
  # 与 HEAD 停在哪儿无关。
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi

  # ① 推的正是审查记录那一笔 ⇒ 已审
  if [ "$LAST_REVIEWED" = "$local_sha" ]; then
    ok_list="${ok_list}   - ${remote_ref:-?} $(echo "$local_sha" | cut -c1-7)（== .push-gate）\n"
    continue
  fi

  # ② 审查记录是它的祖先 ⇒ 它带着未审的新 commit
  if git merge-base --is-ancestor "$LAST_REVIEWED" "$local_sha" 2>/dev/null; then
    blocked=1
    blocked_list="${blocked_list}   - ${remote_ref:-?} $(echo "$local_sha" | cut -c1-7)（有未审 commit：$(echo "$LAST_REVIEWED" | cut -c1-7)..$(echo "$local_sha" | cut -c1-7)）\n"
    continue
  fi

  # ③ 它是审查记录的祖先 ⇒ 推的是**已审历史的子集**（例：dev 已审、往前推一个
  #    落后的源流分支，如 main——实测 main `53690b4` 是 dev `5d527b5` 的祖先）。
  #    内容全在已审面内，放行。这一条**不是旧行为的延续**（旧实现压根没看 sha），
  #    是本票新引入的**显式**判据：没有它，「推已审历史的子集」会掉进 ④ 被误拦，
  #    而误拦合法推送的压力会把人推向 `--no-verify`——正是本票要止住的形态。
  if git merge-base --is-ancestor "$local_sha" "$LAST_REVIEWED" 2>/dev/null; then
    ok_list="${ok_list}   - ${remote_ref:-?} $(echo "$local_sha" | cut -c1-7)（位于已审历史内）\n"
    continue
  fi

  # ④ 两边祖先关系都不成立（reset / rebase / 推了别处的 sha）⇒ **拒**
  #    旧实现这里 exit 0（fail-open）——「HEAD 停在已审点 + 推未审 sha」即由此放行。
  blocked=1
  blocked_list="${blocked_list}   - ${remote_ref:-?} $(echo "$local_sha" | cut -c1-7)（与审查记录无祖先关系：reset/rebase，或非本仓库已审线）\n"
done <<EOF
$PUSH_SPECS
EOF

# 无 refspec（人工直跑 hook / git 未传 stdin）→ 回落 HEAD 校验，保持旧行为。
# 判据是「一行 refspec 都**没解析出**」，**不是**「没有可审的 refspec」——后者会把
# 「只删远端 ref」误并入本分支（见上方 saw_refspec 处注释）。
# （blocked=1 必然蕴含 saw_refspec≥1，故无需再叠加 blocked 判据。）
if [ "$saw_refspec" -eq 0 ]; then
  HEAD_SHA=$(git rev-parse HEAD)
  if [ "$LAST_REVIEWED" = "$HEAD_SHA" ]; then
    exit 0
  fi
  blocked=1
  if git merge-base --is-ancestor "$LAST_REVIEWED" "$HEAD_SHA" 2>/dev/null; then
    blocked_list="${blocked_list}   - (HEAD 回落) $(echo "$HEAD_SHA" | cut -c1-7)（有未审 commit）\n"
  else
    blocked_list="${blocked_list}   - (HEAD 回落) $(echo "$HEAD_SHA" | cut -c1-7)（与审查记录无祖先关系）\n"
  fi
fi

if [ "$blocked" -eq 0 ]; then
  exit 0
fi

# ─── 阻断 ────────────────────────────────────────────────────
echo ""
echo "❌ 推送阻断：本次推送含未经 @吐槽猫 review 的 commit"
echo ""
echo "   最后审查: $(echo "$LAST_REVIEWED" | cut -c1-7)  (.push-gate)"
printf "%b" "$blocked_list"
if [ -n "$ok_list" ]; then
  echo ""
  echo "   （另已放行：）"
  printf "%b" "$ok_list"
fi
echo ""
echo "   审查通过后运行: git rev-parse HEAD > .push-gate"
echo "   紧急绕过: git push --no-verify"
echo ""

# 自动补投滞留交接文档（不重新生成范围版——投递按 commit SHA 幂等）
deliver_pending

exit 1
