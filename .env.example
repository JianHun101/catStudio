# CatStudy 环境变量模板
# 复制此文件为 .env，填入你的 API Key，然后运行 pnpm dev 即可
#   cp .env.example .env
#   (编辑 .env 填入 DS_KEY)
#   pnpm dev

# ── DeepSeek API Key（必填——首次启动自动创建 3 只演示猫）──
# 同时用于 DeepSeek adapter 和 pi adapter（pi 复用同一把 key）
DS_KEY=sk-your-deepseek-api-key

# ── Server ──────────────────────────────────────
# PORT=3200
# HOST=0.0.0.0

# ── Handoff 投递 ─────────────────────────────────
# post-commit hook 自动投递交接文档到 cat-study 消息管道
# CATSTUDY_URL=http://127.0.0.1:3200    # cat-study 服务器地址
# CATSTUDY_SESSION_ID=                  # 目标会话 ID（未设则自动获取第一个）

# ── Redis（可选——不装也能跑，但多进程渠道需要）──
# REDIS_URL=redis://localhost:6379

# ── Agent 超时机制（多层纵深设计）─────
# 层级 1 — CLI idle timeout: 20 分钟无 stdout 输出 → kill（按输出重置）
#   CLI_IDLE_TIMEOUT_MS=1200000  # 毫秒，设为 0 禁用
# 层级 2 — Dispatch hard timeout: 30 分钟 AbortController 绝对上限
#   AGENT_HARD_TIMEOUT_MS=1800000  # 毫秒，设为 0 禁用
# 比例: hard = 1.5x idle，idle 先触发，hard 是最终防线

# ── Claude Code CLI 配置 ─────────────────────────
# CLAUDE_CODE_EFFORT_LEVEL=high  # low | medium | high | max（默认 high，max 思考时间很长）

# ── HuggingFace 模型下载 ────────────────────────
# 中国大陆用户可设为镜像: https://hf-mirror.com
# HF_ENDPOINT=https://huggingface.co

# ── 日志 ────────────────────────────────────────
# LOG_LEVEL=info          # debug | info | warn | error

# ── 记忆系统 ────────────────────────────────────
# MEMORY_ENABLED=true      # 是否启用向量记忆（测试环境建议设为 false）
# MEMORY_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5  # 本地嵌入模型
# MEMORY_DEDUP_ENABLED=1   # 1=启用 | 0=关闭
# MEMORY_DEDUP_THRESHOLD=0.20  # 去重余弦距离阈值（越小越严格）
# MEMORY_UPDATE_THRESHOLD=0.35  # 记忆修正阈值（介于去重与更新之间）
# MEMORY_TOP_K=3           # 检索返回的相关记忆条数
# MEMORY_MAX_DISTANCE=0.6  # 检索距离下限（余弦距离超过此值的记忆不召回）
# MEMORY_QUERY_REWRITE_ENABLED=1  # 查询改写开关（1=启用 | 0=关闭），仅用于检索
# MEMORY_QUERY_REWRITE_MODEL=deepseek-v4-flash  # 改写模型（默认同摘要模型档位）
# MEMORY_FILTER_ENABLED=1   # 入库筛选开关（1=启用 | 0=关闭），只过滤高置信度垃圾（应答词/纯填充/一次性指令）
# MEMORY_MIN_CONTENT_LENGTH=4  # 最小入库内容长度（Unicode 码点数），短于该值的消息不入库

# ── Token 预算与上下文压缩 ───────────────────────
# 控制上下文的 token 预算上限。达到 90% 触发交接，达到 100% 触发截断。
# MAX_CONTEXT_TOKENS=128000  # 单次 LLM 调用的上下文 token 预算上限
# TOKEN_COUNT_METHOD=estimate  # estimate（字符估算）| tiktoken（精确计数）

# ── 增量摘要 ────────────────────────────────────
# 每 N 轮对话异步更新运行中的会话摘要，减少旧消息 token 消耗。
# 使用便宜模型（deepseek-v4-flash, $0.14/1M input tokens, 1M 上下文）。
# SUMMARY_ENABLED=true     # 是否启用增量摘要
# SUMMARY_MODEL=deepseek-v4-flash  # 摘要使用的模型
# SUMMARY_API_KEY=          # 摘要 API Key（默认复用 DS_KEY）
# SUMMARY_BASE_URL=https://api.deepseek.com  # 摘要 API 地址
# SUMMARY_INTERVAL=3        # 每 N 轮对话触发一次摘要

# ── 评估子系统（W2 L2）─────────────────────────
# KIMI_API_KEY=            # Kimi K3 judge 模型 API Key（Moonshot 官方 key，
#                          #   经 deepseek 适配器（OpenAI 兼容 HTTP）访问 https://api.moonshot.cn——K5 接线形态；
#                          #   未配置时 judge 回落 deepseek-v4-flash）
# EVAL_SAMPLE_RATE=0.02    # 回复采样率（随机 1-5%，默认 2%）；只对 DS 族猫回复评分

# ── L1 聚合告警（W1）────────────────────────────
# 30 天窗口每小时聚合，滞回状态机破线才告警（@店长）。
# EVAL_ALERT_SUCCESS_RATE=0.8   # 执行成功率低于此值破线（completed/总执行）
# EVAL_ALERT_TIMEOUT_RATE=0.1   # 超时率高于此值破线
# EVAL_ALERT_REWORK_RATE=0.3    # 返工率高于此值破线（suggest+reject 占审查结论比）

# ── 摘要替代压缩 ──────────────────────────────────
# 长会话 token 压缩：消息超 0.60 阈值异步生成摘要块（下一轮生效）、
# 超 0.75 同步生成（本轮生效）；旧消息压成摘要块保留信息，替代直接丢消息的截断。
# SUMMARY_REPLACE_HISTORY=true  # 开关（'1' 开 / '0' 关，默认开）
# SUMMARY_COMPRESS_LIMIT=3      # 累计压缩次数上限（达上限后走既有 handoff/截断路径）

# ── 会话交接 ────────────────────────────────────
# 上下文使用率达到阈值后，自动创建新会话 + 全量总结 + 前端无缝切换。
# HANDOFF_ENABLED=true      # 是否启用会话交接
# HANDOFF_THRESHOLD=0.9     # 触发交接的上下文 token 占比（0.9 = 90%）
#                           # 可经设置页「系统配置」修改（context-config.json）——配置文件优先于 env

# ── OneBot（QQ 接入）────────────────────────────
# NapCat 等 OneBot v11 实现通过 HTTP 上报接入猫咖（零新增依赖：webhook 入站 + fetch 出站）。
# ONEBOT_ENABLED=false     # 是否启用 OneBot webhook（默认 false，关闭时 webhook 返回 503）
# ONEBOT_API_BASE=http://127.0.0.1:3000  # NapCat HTTP API 地址（P3 出站回复用，P2 仅入站）
# ONEBOT_TOKEN=            # webhook 鉴权 token（设置后上报须带 Authorization: Bearer <token>；留空不校验）
# ONEBOT_FETCH_TIMEOUT_MS=10000  # OneBot 出站 fetch 超时毫秒（P4：NapCat 假死防悬挂；超时 warn 不重试）
# ONEBOT_ALLOWLIST=            # 白名单模式：逗号分隔 QQ 号；配置且非空时只有白名单内的发送者能触发猫（群聊+私聊统一，白名单外静默忽略）；未配置/空 → 关闭
# NAPCAT_LAUNCH_CMD=            # dev.js 拉起 NapCat 的启动命令。两种形态：①完整命令行（如 napcat.exe 路径，含空格路径直接写不用引号——Node 自动组装加引号）；②模板 {NAPCAT_PATH}（纯占位符不带引号）——启动时用配置页面「NapCat 启动路径」保存的路径替换，换机器/换安装位置只改页面不碰 .env，保存后立即生效无需重启。配了 ONEBOT_ENABLED=true 且端口未监听且命令就绪且 autoStart 未关闭（.napcat-config.json 的 autoStart 字段，默认开启、可在设置页关闭）时自动拉起；留空仅提示不拉起。注意：模板形态仅限纯占位符（占位符外不能再带附加 flag/参数，如 {NAPCAT_PATH} --flag）——路径含空格时该组合 cmd /c 下不可解析，启动失败并打警告（规避：改用无空格目录或完整命令行形态）。启动后「操作中」不翻转 → NapCat 未登录 QQ：先浏览器开 WebUI http://127.0.0.1:6099 登录（token 见 shell\napcat\config\webui.json 的 webuiToken），登录后才会监听 ONEBOT_API_BASE 端口
