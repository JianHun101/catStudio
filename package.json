{
  "name": "cat-study",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js --mode production",
    "dev:server": "pnpm --filter @cat-study/server dev",
    "dev:web": "pnpm --filter @cat-study/web dev",
    "seed": "node scripts/seed.js",
    "build": "pnpm -r build",
    "lint": "node scripts/lint.js",
    "stop": "node scripts/stop.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:server": "pnpm --filter @cat-study/server test",
    "test:web": "pnpm --filter @cat-study/web test",
    "test:shared": "pnpm --filter @cat-study/shared test",
    "prepare": "node scripts/hooks-install.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "lint-staged": "^17.0.8",
    "playwright": "^1.62.0",
    "prettier": "^3.9.5",
    "vitest": "^4.1.9"
  }
}
